generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @default("") @map("password_hash")
  name           String?
  photoUrl       String?   @map("photo_url")
  secondaryEmail String?   @map("secondary_email")
  phoneNumber    String?   @map("phone_number")
  occupation     String?
  googleId       String?   @unique @map("google_id")
  githubId       String?   @unique @map("github_id")
  adminRole      String?   @map("admin_role")
  totpSecret     String?   @map("totp_secret")
  is2FAEnabled   Boolean   @default(false) @map("is_2fa_enabled")
  isBanned       Boolean   @default(false) @map("is_banned")
  isSuspended    Boolean   @default(false) @map("is_suspended")
  lastActiveAt   DateTime? @map("last_active_at")
  preferences    Json      @default("{}")
  bio            String?
  website        String?
  linkedin       String?
  github         String?   @map("github_username")
  twitter        String?
  country        String?
  timezone       String?
  language       String?   @default("en")
  theme          String?   @default("system")
  dateFormat     String?   @default("MM/DD/YYYY") @map("date_format")
  timeFormat     String?   @default("12h") @map("time_format")
  fontSize       String?   @default("default") @map("font_size")
  reduceMotion   Boolean   @default(false) @map("reduce_motion")
  highContrast   Boolean   @default(false) @map("high_contrast")
  emailVerified  Boolean   @default(false) @map("email_verified")
  phoneVerified  Boolean   @default(false) @map("phone_verified")
  companyName    String?   @map("company_name")
  companyRole    String?   @map("company_role")
  industry       String?
  companySize    String?   @map("company_size")
  gender         String?
  birthday       DateTime?
  karmaPoints    Int       @default(0) @map("karma_points")
  isVerified     Boolean   @default(false) @map("is_verified")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  memberships           Membership[]
  ownedWorkspaces       Workspace[]             @relation("WorkspaceOwner")
  otps                  Otp[]
  roleAssignments       UserRole[]
  notifications         Notification[]
  notificationPref      NotificationPreference?
  contentReports        ContentReport[]         @relation("ContentReporter")
  contentReviews        ContentReport[]         @relation("ContentReviewer")
  mediaUploads          Media[]
  auditEvents           AuditEvent[]
  recoveryCodes         RecoveryCode[]
  integrations          Integration[]
  securityEvents        SecurityEvent[]
  apiKeys               ApiKey[]
  mailbox               UserMailbox?
  reservedAddresses     ReservedAddress[]
  userApps              UserApp[]
  passkeys              Passkey[]
  linkedAccounts        LinkedAccount[]
  following             Follow[]                @relation("Following")
  followers             Follow[]                @relation("Followers")
  profileViews          ProfileView[]           @relation("ProfileViewsReceived")
  viewedProfiles        ProfileView[]           @relation("ProfileViewer")
  subscriptions         Subscription[]
  invoices              Invoice[]
  verificationRequests  VerificationRequest[]
  reviewerVerifications VerificationRequest[]   @relation("VerificationReviewer")
  loginEvents           LoginEvent[]
  emailPreference       EmailPreference?
  paymentMethods        PaymentMethod[]
  blogs                 Blog[]
  blogComments          BlogComment[]
  ticketsCreated        Ticket[]                @relation("TicketCustomer")
  ticketsAssigned       Ticket[]                @relation("TicketAssignee")
  ticketMessages        TicketMessage[]
  supportAgentSlots     SupportAgent[]
  appOwner              App[]
  incidentsOwned        Incident[]
  projects              Project[]
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
  bookmarks             Bookmark[]
  startups              Startup[]
  achievements          Achievement[]
  communities           Community[]
  communityMembers      CommunityMember[]
  messages              Message[]
  activities            Activity[]
  dataExports           DataExport[]
  authorizationCodes    AuthorizationCode[]
  accessTokens          AccessToken[]
  refreshTokens         RefreshToken[]
  oauthConsents         OAuthConsent[]
  forms                 Form[]
  formCollaborators     FormCollaborator[]

  @@index([email])
  @@index([adminRole])
  @@index([lastActiveAt])
  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@index([slug])
  @@map("workspaces")
}

model Membership {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  workspaceId String        @map("workspace_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  token      String?
  status     String?   @default("active")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  location   String?
  deviceName String?   @map("device_name")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Route {
  id           String   @id @default(cuid())
  path         String
  method       String   @default("GET")
  target       String?
  description  String?
  allowedRoles String[] @default(["member"]) @map("allowed_roles")
  internal     Boolean  @default(false)
  enabled      Boolean  @default(true)
  rateLimit    Int?     @map("rate_limit")
  cacheTtl     Int?     @map("cache_ttl")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([path, method])
  @@map("routes")
}

model Log {
  id        String   @id @default(cuid())
  ip        String?
  method    String
  path      String
  userId    String?  @map("user_id")
  status    Int?
  duration  Int?
  size      Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([ip])
  @@index([userId])
  @@map("logs")
}

model Blocklist {
  id        String    @id @default(cuid())
  type      String
  value     String
  reason    String?
  addedById String?   @map("added_by_id")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([type, value])
  @@index([value])
  @@map("blocklist")
}

model SiteConfig {
  id        String   @id @default(cuid())
  app       String   @unique
  config    Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([app])
  @@map("site_configs")
}

model AppRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#4f7aff")
  icon        String   @default("shield")
  isSystem    Boolean  @default(false) @map("is_system")
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments UserRole[]

  @@index([name])
  @@map("app_roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Otp {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("otps")
}

model SignupOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("signup_otps")
}

// ─── Email System ──────────────────────────────────────

model EmailConfig {
  id        String   @id @default(cuid())
  provider  String   @default("resend")
  apiKey    String?  @map("api_key")
  smtpHost  String?  @map("smtp_host")
  smtpPort  Int?     @map("smtp_port")
  smtpUser  String?  @map("smtp_user")
  smtpPass  String?  @map("smtp_pass")
  fromEmail String   @default("noreply@tirbeo.app") @map("from_email")
  fromName  String   @default("Tirbeo") @map("from_name")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_configs")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  subject   String
  htmlBody  String   @map("html_body")
  variables Json     @default("[]")
  fromEmail String?  @map("from_email")
  fromName  String?  @map("from_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("email_templates")
}

// ─── Notifications ─────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  link      String?
  icon      String?
  priority  Int?
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  emailSent Boolean   @default(false) @map("email_sent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  emailDigest String   @default("daily") @map("email_digest")
  digestTime  String   @default("08:00") @map("digest_time")
  mention     Boolean  @default(true)
  comment     Boolean  @default(true)
  report      Boolean  @default(true)
  system      Boolean  @default(true)
  marketing   Boolean  @default(false)
  security    Boolean  @default(true)
  product     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Content Moderation ─────────────────────────────────

model ContentReport {
  id           String    @id @default(cuid())
  reporterId   String    @map("reporter_id")
  targetType   String    @map("target_type")
  targetId     String    @map("target_id")
  reason       String
  description  String?
  status       String    @default("pending")
  priority     String?
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  action       String?
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  reporter   User  @relation("ContentReporter", fields: [reporterId], references: [id])
  reviewedBy User? @relation("ContentReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("content_reports")
}

// ─── Media Library ──────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  fileName     String   @map("file_name")
  originalName String?  @map("original_name")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  url          String
  storagePath  String?  @map("storage_path")
  thumbnail    String?
  altText      String?  @map("alt_text")
  caption      String?
  width        Int?
  height       Int?
  duration     Int?
  uploadedById String   @map("uploaded_by")
  folder       String   @default("general")
  tags         Json     @default("[]")
  isPublic     Boolean  @default(true) @map("is_public")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([folder])
  @@index([mimeType])
  @@index([uploadedById])
  @@map("media")
}

// ─── Audit Trail ────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  severity   String   @default("info")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([severity])
  @@index([createdAt])
  @@map("audit_events")
}

// ─── Security Events ────────────────────────────────────

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  location    String?
  metadata    Json     @default("{}")
  severity    String   @default("info")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("security_events")
}

// ─── 2FA / Recovery Codes ───────────────────────────────

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  code      String
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("recovery_codes")
}

// ─── Newsletter Subscribers ────────────────────────────

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("landing")
  status    String   @default("active")
  tags      Json     @default("[]")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("subscribers")
}

model Integration {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  provider     String
  connected    Boolean   @default(false)
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  scope        String?
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("integrations")
}

// ─── Theme Configuration ───────────────────────────────

model ThemeConfig {
  id        String  @id @default(uuid())
  name      String  @unique
  isActive  Boolean @default(false) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")

  bgPrimary   String @default("#08150F") @map("bg_primary")
  bgSecondary String @default("#101c13") @map("bg_secondary")
  bgCard      String @default("#12271D") @map("bg_card")
  bgElevated  String @default("#1a3326") @map("bg_elevated")

  textPrimary   String @default("#F2EEE8") @map("text_primary")
  textSecondary String @default("#B7C6BE") @map("text_secondary")
  textMuted     String @default("#6b8a7a") @map("text_muted")

  accentPrimary   String @default("#569578") @map("accent_primary")
  accentSecondary String @default("#275d46") @map("accent_secondary")
  accentHover     String @default("#6aab8d") @map("accent_hover")

  success String @default("#59C173")
  warning String @default("#F4B942")
  error   String @default("#E45D5D")

  borderColor String @default("rgba(255,255,255,0.08)") @map("border_color")
  borderHover String @default("rgba(255,255,255,0.14)") @map("border_hover")

  fontPrimary  String @default("Inter") @map("font_primary")
  fontHeading  String @default("Plus Jakarta Sans") @map("font_heading")
  borderRadius String @default("16px") @map("border_radius")

  logoUrl      String? @map("logo_url")
  brandName    String  @default("Tirbeo") @map("brand_name")
  brandTagline String  @default("Premium Social Platform") @map("brand_tagline")

  lightBgPrimary     String? @map("light_bg_primary")
  lightBgSecondary   String? @map("light_bg_secondary")
  lightTextPrimary   String? @map("light_text_primary")
  lightAccentPrimary String? @map("light_accent_primary")

  emailHeaderBg    String @default("linear-gradient(135deg,#022B22,#275D46,#569578)") @map("email_header_bg")
  emailButtonColor String @default("#569578") @map("email_button_color")
  emailTextColor   String @default("#B7C6BE") @map("email_text_color")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("theme_configs")
}

model District {
  id       Int    @id @default(autoincrement())
  name     String @unique
  province Int

  @@map("districts")
}

// ─── Developer API Keys ───────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  keyHash    String    @unique @map("key_hash")
  prefix     String
  active     Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─── User Mailbox (Internal Email) ───────────────────

model UserMailbox {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  address   String   @unique
  forwardTo String   @map("forward_to")
  isActive  Boolean  @default(true) @map("is_active")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address])
  @@map("user_mailboxes")
}

// ─── Reserved Mailbox Addresses (Admin-Managed) ─────

model ReservedAddress {
  id        String   @id @default(cuid())
  address   String   @unique
  reason    String   @default("reserved")
  level     String   @default("hard") // hard = nobody, soft = admin can override
  category  String   @default("system") // system, role, branding, custom
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([address])
  @@index([level])
  @@index([category])
  @@map("reserved_addresses")
}

model UserApp {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  description   String   @default("")
  url           String
  icon          String?
  color         String?
  status        String   @default("active") // active, inactive
  notifications Int      @default(0)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_apps")
}

// ─── Passkeys / WebAuthn ───────────────────────────────

model Passkey {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  credentialId        String   @unique @map("credential_id")
  credentialPublicKey Bytes    @map("credential_public_key")
  counter             BigInt   @default(0)
  transports          String?
  deviceName          String?  @map("device_name")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("passkeys")
}

// ─── Passkey Challenges (DB-backed, survives serverless cold starts) ──

model PasskeyChallenge {
  id        String   @id @default(cuid())
  nonce     String   @unique
  challenge String
  type      String // "register" or "auth"
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([nonce])
  @@index([expiresAt])
  @@map("passkey_challenges")
}

// ─── Linked Accounts (OAuth Providers) ────────────────

model LinkedAccount {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  provider    String // "google", "github", "discord", etc.
  providerId  String   @map("provider_id") // The provider's user ID
  email       String?
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
  @@map("linked_accounts")
}

// ─── Social Graph (Follow / Connection) ─────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
  @@map("follows")
}

// ─── Profile Views (analytics) ─────────────────────────

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String?  @map("viewer_id")
  profileId String   @map("profile_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  viewer  User? @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: SetNull)
  profile User  @relation("ProfileViewsReceived", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([viewerId])
  @@index([createdAt])
