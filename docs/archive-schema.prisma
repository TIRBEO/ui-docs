// ─── Forms ─────────────────────────────────────────

model Form {
  id             String   @id @default(uuid())
  title          String
  description    String?  @db.Text
  status         String   @default("draft")
  ownerId        String   @map("owner_id")
  publicId       String   @unique @map("public_id")
  slug           String?
  coverImage     String?  @map("cover_image")
  customDomain   String?  @map("custom_domain")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  visibility     String   @default("private")
  loginRequired  Boolean  @default(false) @map("login_required")
  captchaEnabled Boolean  @default(false) @map("captcha_enabled")
  rateLimit      Int?     @map("rate_limit")
  limitPerUser   Int?     @map("limit_per_user")
  responseLimit  Int?     @map("response_limit")
  expiresAt      DateTime? @map("expires_at")
  scheduledAt    DateTime? @map("scheduled_at")
  closeAt        DateTime? @map("close_at")
  openMessage    String?  @map("open_message") @db.Text
  closeMessage   String?  @map("close_message") @db.Text
  thankYouMessage String? @map("thank_you_message") @db.Text
  redirectUrl    String?  @map("redirect_url")
  collectEmail   Boolean  @default(false) @map("collect_email")
  confirmBeforeSubmit Boolean @default(true) @map("confirm_before_submit")
  showProgressBar Boolean @default(true) @map("show_progress_bar")
  shuffleFields  Boolean  @default(false) @map("shuffle_fields")
  allowEdit      Boolean  @default(true) @map("allow_edit")
  allowDelete    Boolean  @default(false) @map("allow_delete")
  responseCount  Int      @default(0) @map("response_count")
  viewCount      Int      @default(0) @map("view_count")
  submissionCountToday Int @default(0) @map("submission_count_today")
  lastSubmissionAt DateTime? @map("last_submission_at")
  color          String?  @default("#2563EB")
  fontSize       String?  @default("medium")
  layout         String?  @default("default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner         User            @relation(fields: [ownerId], references: [id])
  versions      FormVersion[]
  fields        FormField[]
  pages         FormPage[]
  conditions    FormCondition[]
  responses     Response[]
  collaborators FormCollaborator[]
  webhooks      FormWebhook[]
  notifications FormNotification[]
  views         FormView[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("forms")
}

model FormVersion {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  version   Int
  data      Json
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, version])
  @@index([formId])
  @@map("form_versions")
}

model FormPage {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  title     String?
  order     Int
  createdAt DateTime @default(now()) @map("created_at")

  form   Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields FormField[]

  @@unique([formId, order])
  @@index([formId])
  @@map("form_pages")
}

model FormField {
  id          String   @id @default(uuid())
  formId      String   @map("form_id")
  pageId      String?  @map("page_id")
  type        String
  label       String
  description String?  @db.Text
  placeholder String?
  required    Boolean  @default(false)
  order       Int
  defaultValue Json?   @map("default_value")
  properties  Json     @default("{}")
  validation  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  form    Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  page    FormPage?         @relation(fields: [pageId], references: [id])
  options FormFieldOption[]
  conditionsAsSource FormCondition[] @relation("ConditionSource")
  conditionsAsTarget FormCondition[] @relation("ConditionTarget")
  answers ResponseAnswer[]

  @@index([formId])
  @@index([pageId])
  @@map("form_fields")
}

model FormFieldOption {
  id        String   @id @default(uuid())
  fieldId   String   @map("field_id")
  label     String
  value     String
  order     Int
  createdAt DateTime @default(now()) @map("created_at")

  field FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@map("form_field_options")
}

model FormCondition {
  id         String   @id @default(uuid())
  formId     String   @map("form_id")
  sourceFieldId String @map("source_field_id")
  targetFieldId String @map("target_field_id")
  operator   String
  value      String
  action     String   @default("show")
  createdAt  DateTime @default(now()) @map("created_at")

  form         Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  sourceField  FormField @relation("ConditionSource", fields: [sourceFieldId], references: [id], onDelete: Cascade)
  targetField  FormField @relation("ConditionTarget", fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_conditions")
}

model Response {
  id            String    @id @default(uuid())
  formId        String    @map("form_id")
  respondentId  String?   @map("respondent_id")
  respondentName String?  @map("respondent_name")
  respondentEmail String? @map("respondent_email")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  duration      Int?      @map("duration")
  status        String    @default("completed")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  form    Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers ResponseAnswer[]
  notes   ResponseNote[]

  @@index([formId])
  @@index([respondentId])
  @@index([createdAt])
  @@map("responses")
}

model ResponseAnswer {
  id         String   @id @default(uuid())
  responseId String   @map("response_id")
  fieldId    String   @map("field_id")
  value      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  response Response  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    FormField @relation(fields: [fieldId], references: [id])

  @@unique([responseId, fieldId])
  @@index([fieldId])
  @@map("response_answers")
}

model ResponseNote {
  id         String   @id @default(uuid())
  responseId String   @map("response_id")
  content    String   @db.Text
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@map("response_notes")
}

model FormCollaborator {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  userId    String   @map("user_id")
  role      String   @default("editor")
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([formId, userId])
  @@map("form_collaborators")
}

model FormWebhook {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  url       String
  events    Json     @default("[]")
  secret    String?
  active    Boolean  @default(true)
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_webhooks")
}

model FormNotification {
  id                  String   @id @default(uuid())
  formId              String   @map("form_id")
  notifyOnSubmission  Boolean  @default(true) @map("notify_on_submission")
  notifyOwner         Boolean  @default(true) @map("notify_owner")
  notifyCollaborators Boolean  @default(false) @map("notify_collaborators")
  additionalEmails    Json     @default("[]") @map("additional_emails")
  sendConfirmation    Boolean  @default(true) @map("send_confirmation")
  confirmationTemplate String? @map("confirmation_template") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId])
  @@map("form_notifications")
}

model FormView {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  name      String
  columns   Json     @default("[]")
  filters   Json     @default("[]")
  sorting   Json     @default("{}")
  isDefault Boolean  @default(false) @map("is_default")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_views")
}

// ─── Support Tickets ─────────────────────────────────────

model Ticket {
  id          String    @id @default(cuid())
  customerId  String    @map("customer_id")
  subject     String
  description String?   @db.Text
  category    String    @default("general")
  priority    String    @default("normal")
  status      String    @default("open")
  source      String    @default("web")
  application String?
  queueId     String?   @map("queue_id")
  assignedId  String?   @map("assigned_id")
  slaId       String?   @map("sla_id")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer    User               @relation("TicketCustomer", fields: [customerId], references: [id])
  assigned    User?              @relation("TicketAssignee", fields: [assignedId], references: [id])
  queue       SupportQueue?      @relation(fields: [queueId], references: [id])
  sla         SLA?               @relation(fields: [slaId], references: [id])
  messages    TicketMessage[]
  attachments TicketAttachment[]
  assignments TicketAssignment[]

  @@index([customerId])
  @@index([assignedId])
  @@index([status])
  @@index([priority])
  @@index([queueId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  fileName   String   @map("file_name")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  url        String
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketAssignment {
  id           String    @id @default(cuid())
  ticketId     String    @map("ticket_id")
  agentId      String    @map("agent_id")
  assignedBy   String    @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([agentId])
  @@map("ticket_assignments")
}

model SupportQueue {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  managerId    String?  @map("manager_id")
  autoAssign   Boolean  @default(true) @map("auto_assign")
  slaId        String?  @map("sla_id")
  workingHours Json     @default("{}") @map("working_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tickets Ticket[]
  agents  SupportAgent[]
  sla     SLA?           @relation("QueueSLA", fields: [slaId], references: [id])

  @@index([slug])
  @@map("support_queues")
}

model SupportAgent {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  queueId    String   @map("queue_id")
  role       String   @default("agent")
  isActive   Boolean  @default(true) @map("is_active")
  maxTickets Int      @default(10) @map("max_tickets")
  createdAt  DateTime @default(now()) @map("created_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue SupportQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([userId, queueId])
  @@index([userId])
  @@map("support_agents")
}

model SLA {
  id               String   @id @default(cuid())
  name             String   @unique
  firstResponse    Int      @default(3600) @map("first_response")
  resolutionTime   Int      @default(86400) @map("resolution_time")
  escalationTime   Int?     @map("escalation_time")
  priority         String   @default("normal")
  workingHoursOnly Boolean  @default(true) @map("working_hours_only")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tickets       Ticket[]
  supportQueues SupportQueue[] @relation("QueueSLA")

  @@map("slas")
}

// ─── Reports ─────────────────────────────────────────────

model Report {
  id          String    @id @default(uuid())
  name        String
  description String?
  type        String    @default("custom")
  config      Json      @default("{}")
  createdBy   String    @map("created_by")
  isScheduled Boolean   @default(false) @map("is_scheduled")
  schedule    String?   @map("schedule")
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  schedules ReportSchedule[]

  @@index([createdBy])
  @@map("reports")
}

model ReportSchedule {
  id         String    @id @default(uuid())
  reportId   String    @map("report_id")
  cron       String
  format     String    @default("csv")
  recipients Json      @default("[]")
  enabled    Boolean   @default(true)
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_schedules")
}

// ─── Data Export ─────────────────────────────────────────

model DataExport {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String    @default("full")
  format      String    @default("json")
  status      String    @default("pending")
  fileUrl     String?   @map("file_url")
  fileSize    Int?      @map("file_size")
  expiresAt   DateTime? @map("expires_at")
  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_exports")
}

// ─── Background Jobs ─────────────────────────────────────

model Job {
  id          String    @id @default(uuid())
  type        String
  queue       String    @default("default")
  payload     Json      @default("{}")
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  attemptsList JobAttempt[]

  @@index([status])
  @@index([type])
  @@index([queue])
  @@index([createdAt])
  @@map("jobs")
}

model JobAttempt {
  id          String    @id @default(uuid())
  jobId       String    @map("job_id")
  attempt     Int
  status      String
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_attempts")
}

// ─── Incidents ───────────────────────────────────────────

model Incident {
  id           String    @id @default(uuid())
  title        String
  description  String?   @db.Text
  severity     String    @default("minor")
  status       String    @default("investigating")
  services     Json      @default("[]")
  applications Json      @default("[]")
  ownerId      String?   @map("owner_id")
  resolvedAt   DateTime? @map("resolved_at")
  postmortem   String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner  User?           @relation(fields: [ownerId], references: [id])
  events IncidentEvent[]

  @@index([status])
  @@index([severity])
  @@map("incidents")
}

model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  type       String
  message    String?  @db.Text
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_events")
}

// ─── System Services ────────────────────────────────────

model SystemService {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique
  description   String?
  type          String    @default("api")
  status        String    @default("operational")
  url           String?
  version       String?
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("system_services")
}

// ─── Applications Registry ──────────────────────────────

model App {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  url         String?
  status      String   @default("active")
  isPublic    Boolean  @default(true) @map("is_public")
  ownerId     String   @map("owner_id")
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner        User             @relation(fields: [ownerId], references: [id])
  oauthClients AppOAuthClient[]
  permissions  AppPermission[]

  @@index([slug])
  @@index([ownerId])
  @@map("apps")
}

model AppPermission {
  id          String   @id @default(uuid())
  appId       String   @map("app_id")
  name        String
  key         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, key])
  @@index([appId])
  @@index([key])
  @@map("app_permissions")
}

model AppOAuthClient {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  clientId     String   @unique @map("client_id")
  clientSecret String?  @map("client_secret")
  redirectUris Json     @default("[]") @map("redirect_uris")
  grants       Json     @default("[]")
  scopes       Json     @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([appId])
  @@map("app_oauth_clients")
}

model AuthorizationCode {
  id                 String   @id @default(uuid())
  clientId           String   @map("client_id")
  userId             String   @map("user_id")
  code               String   @unique
  redirectUri        String   @map("redirect_uri")
  codeChallenge      String?  @map("code_challenge")
  codeChallengeMethod String? @default("S256") @map("code_challenge_method")
  scopes             Json     @default("[]")
  expiresAt          DateTime @map("expires_at")
  usedAt             DateTime? @map("used_at")
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([clientId])
  @@map("authorization_codes")
}

model AccessToken {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  token     String    @unique
  scopes    Json      @default("[]")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([clientId])
  @@map("access_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  token     String    @unique
  scopes    Json      @default("[]")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  parentId  String?   @unique @map("parent_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([clientId])
  @@map("refresh_tokens")
}

model OAuthConsent {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  userId    String   @map("user_id")
  scopes    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
  @@index([clientId])
  @@map("oauth_consents")
}
